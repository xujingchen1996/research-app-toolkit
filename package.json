{
  "name": "@xujingchen1996/research-app-toolkit",
  "version": "0.3.0",
  "description": "科研申请工具包：Claude Code、Codex 与 DSH 九个申请技能，DSH 四页工作台及统一安装器。",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/xujingchen1996/research-app-toolkit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xujingchen1996/research-app-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/xujingchen1996/research-app-toolkit/issues"
  },
  "author": "Jingchen Xu",
  "bin": {
    "ratk": "bin/ratk.js"
  },
  "files": [
    ".claude-plugin",
    ".codex-plugin",
    "LICENSE",
    "README.md",
    "agents",
    "assets",
    "bin",
    "codex",
    "commands",
    "hooks",
    "lib",
    "skills",
    "README.zh.md",
    "dsh/lib",
    "dsh/skills",
    "dsh/templates",
    "dsh/references",
    "dsh/cordis.patch.yml"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.js dsh/tests/*.test.mjs",
    "test:dsh": "node scripts/test-dsh.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "claude-code",
    "codex",
    "phd",
    "mres",
    "mphil",
    "research-application",
    "cv",
    "cold-email",
    "professor-match",
    "interview-prep",
    "presentation",
    "ppt",
    "deepseek",
    "dsh",
    "agent-preset"
  ],
  "exports": {
    ".": "./dsh/lib/index.mjs",
    "./client": "./dsh/lib/client.js",
    "./package.json": "./package.json",
    "./installer": "./lib/installer.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
